{
  "name": "troubleshooting-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web portal panduan troubleshooting & tutorial penanganan gangguan komputer dan jaringan.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build && npm run clean:cloudflare-output",
    "clean:cloudflare-output": "node -e \"require('node:fs').rmSync('.cloudflare/output', { recursive: true, force: true })\"",
    "preview:worker": "opennextjs-cloudflare preview",
    "preview": "npm run build:worker && npm run preview:worker",
    "start": "next start",
    "lint": "eslint",
    "deploy": "opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "animejs": "^4.5.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.66.0",
    "next": "16.4.5",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remixicon": "^4.9.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/postcss": "^4.3.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4",
    "wrangler": "^4.157.0"
  },
  "type": "module"
}
